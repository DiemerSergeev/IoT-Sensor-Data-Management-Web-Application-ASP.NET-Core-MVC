@model IEnumerable<Tsk3.Models.DataBaseItem>
@{
    ViewData["Title"] = "Архив показаний";
}

<h2 class="text-center text-white my-4">Архив показаний</h2>

<div class="container">
    
    <!-- Фильтр -->
    <div class="card shadow p-4 mb-4">
        <div class="card-body">
            <h5 class="card-title text-muted mb-3">Фильтр</h5>
            
            <form method="get" asp-action="ShowDataTable">
                <!-- !!! ДОБАВЬТЕ ЭТУ СТРОКУ !!! -->
                <!-- Это сохраняет текущую сортировку при нажатии кнопок Найти/Excel/XML -->
                <input type="hidden" name="sortOrder" value="@ViewBag.CurrentSort" />

                <div class="row g-3 align-items-end">
                    
                    <div class="col-md-3">
                        <label class="form-label fw-bold small">Датчик</label>
                        <input type="text" name="sensorName" class="form-control" 
                               value="@ViewBag.SensorName" placeholder="Название" />
                    </div>
                    
                    <div class="col-md-3">
                        <label class="form-label fw-bold small">Тип данных</label>
                        <input type="text" name="dataType" class="form-control" 
                               value="@ViewBag.DataType" placeholder="Тип" />
                    </div>
                    
                    <div class="col-md-2">
                        <label class="form-label fw-bold small">Позиция</label>
                        <input type="text" name="position" class="form-control" 
                               value="@ViewBag.Position" placeholder="№" />
                    </div>

                    <!-- Убрали класс mb-3, чтобы выравнивание сработало корректно -->
                    <div class="col-md-2">
                        <label class="form-label fw-bold small">С (дата)</label>
                        <input type="date"
                               name="startDate"
                               class="form-control"
                               value="@ViewBag.StartDate" />
                    </div>

                    <!-- Убрали класс mb-3 -->
                    <div class="col-md-2">
                        <label class="form-label fw-bold small">По (дата)</label>
                        <input type="date"
                               name="endDate"
                               class="form-control"
                               value="@ViewBag.EndDate" />
                    </div>
                </div>
                
               <div class="row mt-3">
                    <!-- ЛЕВАЯ ЧАСТЬ: Кнопки скачивания -->
                    <div class="col-md-6 d-flex align-items-center">
                        <span class="text-muted small me-2">Скачать:</span>
                        
                        <!-- Кнопка Excel -->
                        <!-- asp-action отправляет данные формы в метод SaveToExcelFile -->
                        <button type="submit" asp-action="SaveToExcelFile" class="btn btn-success btn-sm me-2">
                            Excel
                        </button>

                        <!-- Кнопка XML -->
                        <!-- asp-action отправляет данные формы в метод SaveToXmlFile -->
                        <button type="submit" asp-action="SaveToXmlFile" class="btn btn-warning btn-sm text-dark">
                            XML
                        </button>
                    </div>

                    <!-- ПРАВАЯ ЧАСТЬ: Поиск и сброс (как было) -->
                    <div class="col-md-6 text-end">
                        <a asp-action="ShowDataTable" class="btn btn-secondary btn-sm me-2">Сброс</a>
                        <!-- Явно указываем asp-action="ShowDataTable" для кнопки поиска -->
                        <button type="submit" asp-action="ShowDataTable" class="btn btn-primary px-4">Найти</button>
                    </div>
                </div>

            </form>
        </div>
    </div>

    <!-- Таблица -->
   
    <div class="card shadow mb-5">
        <div class="card-body p-0">
            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover mb-0">
                        <thead style="background-color: #2a5298; color: white;">
                            <tr>
                                <th class="py-3 px-4">
                                    <a asp-action="ShowDataTable"
                                       asp-route-sortOrder="@ViewBag.IdSortParm"
                                       asp-route-sensorName="@ViewBag.SensorName"
                                       asp-route-dataType="@ViewBag.DataType"
                                       asp-route-position="@ViewBag.Position"
                                       asp-route-startDate="@ViewBag.StartDate"
                                       asp-route-endDate="@ViewBag.EndDate"
                                       class="text-white text-decoration-none">
                                        ID
                                        @if (ViewBag.CurrentSort == "id_asc")
                                        {
                                            <span>▲</span>
                                        }
                                        @if (ViewBag.CurrentSort == "id_desc")
                                        {
                                            <span>▼</span>
                                        }
                                    </a>
                                </th>

                                <!-- ДАТЧИК -->
                                <th class="py-3">
                                    <a asp-action="ShowDataTable"
                                       asp-route-sortOrder="@ViewBag.NameSortParm"
                                       asp-route-sensorName="@ViewBag.SensorName"
                                       asp-route-dataType="@ViewBag.DataType"
                                       asp-route-position="@ViewBag.Position"
                                       asp-route-startDate="@ViewBag.StartDate"
                                       asp-route-endDate="@ViewBag.EndDate"
                                       class="text-white text-decoration-none">
                                        Датчик
                                        @if (ViewBag.CurrentSort == "name_asc")
                                        {
                                            <span>▲</span>
                                        }
                                        @if (ViewBag.CurrentSort == "name_desc")
                                        {
                                            <span>▼</span>
                                        }
                                    </a>
                                </th>

                                <!-- ТИП -->
                                <th class="py-3">
                                    <a asp-action="ShowDataTable"
                                       asp-route-sortOrder="@ViewBag.TypeSortParm"
                                       asp-route-sensorName="@ViewBag.SensorName"
                                       asp-route-dataType="@ViewBag.DataType"
                                       asp-route-position="@ViewBag.Position"
                                       asp-route-startDate="@ViewBag.StartDate"
                                       asp-route-endDate="@ViewBag.EndDate"
                                       class="text-white text-decoration-none">
                                        Тип
                                        @if (ViewBag.CurrentSort == "type_asc")
                                        {
                                            <span>▲</span>
                                        }
                                        @if (ViewBag.CurrentSort == "type_desc")
                                        {
                                            <span>▼</span>
                                        }
                                    </a>
                                </th>

                                <!-- ПОЗИЦИЯ -->
                                <th class="py-3">
                                    <a asp-action="ShowDataTable"
                                       asp-route-sortOrder="@ViewBag.PosSortParm"
                                       asp-route-sensorName="@ViewBag.SensorName"
                                       asp-route-dataType="@ViewBag.DataType"
                                       asp-route-position="@ViewBag.Position"
                                       asp-route-startDate="@ViewBag.StartDate"
                                       asp-route-endDate="@ViewBag.EndDate"
                                       class="text-white text-decoration-none">
                                        Поз.
                                        @if (ViewBag.CurrentSort == "pos_asc")
                                        {
                                            <span>▲</span>
                                        }
                                        @if (ViewBag.CurrentSort == "pos_desc")
                                        {
                                            <span>▼</span>
                                        }
                                    </a>
                                </th>

                                <!-- ЗНАЧЕНИЕ -->
                                <th class="py-3">
                                    <a asp-action="ShowDataTable"
                                       asp-route-sortOrder="@ViewBag.ValSortParm"
                                       asp-route-sensorName="@ViewBag.SensorName"
                                       asp-route-dataType="@ViewBag.DataType"
                                       asp-route-position="@ViewBag.Position"
                                       asp-route-startDate="@ViewBag.StartDate"
                                       asp-route-endDate="@ViewBag.EndDate"
                                       class="text-white text-decoration-none">
                                        Значение
                                        @if (ViewBag.CurrentSort == "val_asc")
                                        {
                                            <span>▲</span>
                                        }
                                        @if (ViewBag.CurrentSort == "val_desc")
                                        {
                                            <span>▼</span>
                                        }
                                    </a>
                                </th>

                                <!-- ДАТА -->
                                <th class="py-3">
                                    <a asp-action="ShowDataTable"
                                       asp-route-sortOrder="@ViewBag.DateSortParm"
                                       asp-route-sensorName="@ViewBag.SensorName"
                                       asp-route-dataType="@ViewBag.DataType"
                                       asp-route-position="@ViewBag.Position"
                                       asp-route-startDate="@ViewBag.StartDate"
                                       asp-route-endDate="@ViewBag.EndDate"
                                       class="text-white text-decoration-none">
                                        Дата
                                        @if (ViewBag.CurrentSort == "date_asc")
                                        {
                                            <span>▲</span>
                                        }
                                        @if (string.IsNullOrEmpty(ViewBag.CurrentSort) || ViewBag.CurrentSort == "date_desc")
                                        {
                                            <span>▼</span>
                                        }
                                    </a>
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="px-4">@item.Id</td>
                                    <td>@item.SensorName</td>
                                    <td><span class="badge bg-info text-dark">@item.DataType</span></td>
                                    <td>@item.Position</td>
                                    <td class="fw-bold">@item.Value</td>
                                    <td>@item.Date</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="p-5 text-center text-muted">
                    <p>Данные не найдены.</p>
                </div>
            }
        </div>
    </div>
</div>